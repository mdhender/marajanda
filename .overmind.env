# Overmind reads this file for its own settings, so `overmind start` needs no
# flags here. Process environment for the daemon comes from .env.development.local
# by way of internal/dotenv, not from here.
OVERMIND_PROCFILE=Procfile.dev

# Overmind hands each process a $PORT it assigns. This project takes its port
# from MARAJANDA_PORT, and an unused $PORT in the environment only invites a
# process to bind the wrong one.
OVERMIND_NO_PORT=1
